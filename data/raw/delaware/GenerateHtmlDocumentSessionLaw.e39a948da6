      <p dir="ltr" class="pt-Normal">
        <span class="pt-DefaultParagraphFont">CHAPTER 347</span>
      </p>
      <p dir="ltr" class="pt-Normal">
        <span class="pt-DefaultParagraphFont">153rd GENERAL ASSEMBLY</span>
      </p>
      <p dir="ltr" class="pt-Normal">
        <span class="pt-DefaultParagraphFont">FORMERLY</span>
      </p>
      <p dir="ltr" class="pt-Normal">
        <span class="pt-DefaultParagraphFont">SENATE BILL NO. 337</span>
      </p>
      <p dir="ltr" class="pt-Normal-000000">
        <span xml:space="preserve" class="pt-000001"> </span>
      </p>
      <p dir="ltr" class="pt-Normal-000002">
        <span class="pt-DefaultParagraphFont">AN ACT MAKING APPROPRIATIONS FOR CERTAIN GRANTS-IN-AID FOR THE FISCAL YEAR ENDING JUNE 30, 2027; SPECIFYING CERTAIN PROCEDURES, CONDITIONS AND LIMITATIONS FOR THE EXPENDITURE OF SUCH FUNDS; AMENDING THE FISCAL YEAR 2027 APPROPRIATIONS ACT; AND AMENDING CERTAIN STATUTORY PROVISIONS.</span>
      </p>
      <p dir="ltr" class="pt-Normal-000000">
        <span xml:space="preserve" class="pt-000001"> </span>
      </p>
      <p dir="ltr" class="pt-Normal-000002">
        <span class="pt-DefaultParagraphFont">BE IT ENACTED BY THE GENERAL ASSEMBLY OF THE STATE OF DELAWARE (Three-fourths of all members elected to each house thereof concurring therein):</span>
      </p>
      <p dir="ltr" class="pt-Normal-000000">
        <span xml:space="preserve" class="pt-000001"> </span>
      </p>
      <p dir="ltr" class="pt-Normal-000003">
        <span class="pt-DefaultParagraphFont">Approved July 15, 2026</span>
      </p>
      <p dir="ltr" class="pt-Normal-000000">
        <span xml:space="preserve" class="pt-000001"> </span>
      </p>
