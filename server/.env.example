# Copy these into Vercel: Project > Settings > Environment Variables.
# Never put real values in this file or anywhere in the repository.

# Supabase: Project Settings > API. The secret key can read everything, so it stays on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic Console > API keys.
ANTHROPIC_API_KEY=

# Stripe (test mode first). The price comes from the product you create in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# A live key stays switched off until this says yes.
ALLOW_LIVE_PAYMENTS=no
# Set to yes only after setting up Stripe Tax.
STRIPE_AUTOMATIC_TAX=no

# Where the website lives. ALLOWED_ORIGINS has no path.
SITE_URL=https://dbn202788.github.io/funding-atlas/
ALLOWED_ORIGINS=https://dbn202788.github.io
ATLAS_DATA_URL=https://dbn202788.github.io/funding-atlas/data

# Limits. Replace these starting values once real cost per question is measured.
FREE_QUESTIONS_PER_MONTH=3
MEMBER_QUESTIONS_PER_MONTH=50
MONTHLY_BUDGET_USD=25
QUESTION_RESERVE_USD=1
ADVISOR_MODEL=claude-opus-5-5
ADVISOR_EFFORT=medium
